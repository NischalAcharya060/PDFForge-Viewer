{
  "name": "pdfforge-viewer",
  "version": "1.1.0",
  "description": "A fast, private, offline desktop PDF viewer.",
  "main": "electron/main.js",
  "author": {
    "name": "Grdh_Ravan",
    "email": "Nischal060@gmail.com"
  },
  "homepage": "https://pdfforge.acharyanischal.com.np/",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "build:windows": "electron-builder --win nsis",
    "build:linux": "node scripts/build-linux.js",
    "build:snap": "node scripts/build-snap.js",
    "dist": "electron-builder --win nsis",
    "lint": "node --check electron/main.js && node --check electron/preload.js && node --check electron/services/file-association.js && node --check electron/services/rich-to-pdf.js && node --check electron/services/text-to-pdf.js && node --check electron/utils/pdf-helpers.js && node --check scripts/build-linux.js && node --check scripts/build-snap.js && node scripts/lint-renderer.js",
    "test": "npm run lint && npm run test:rich",
    "test:rich": "node scripts/rich-smoke.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pdfforge.viewer",
    "productName": "PDFForge Viewer",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "scripts/notify-shell.ps1",
      "node_modules/pdfjs-dist/build/**/*",
      "node_modules/pdfjs-dist/web/**/*",
      "node_modules/pdf-lib/**/*",
      "node_modules/@pdf-lib/**/*",
      "node_modules/quill/dist/**/*",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdf-lib/**/*.map",
      "!node_modules/@pdf-lib/**/*.map",
      "!node_modules/quill/**/*.map",
      "!renderer/viewer.js",
      "!renderer/styles.css",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/brand-icon.png",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDFForge Viewer",
          "description": "PDFForge Viewer document",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "PDFForge-Setup.${ext}",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "uninstallDisplayName": "PDFForge Viewer",
      "shortcutName": "PDFForge Viewer"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz",
        "snap"
      ],
      "executableName": "pdfforge-viewer",
      "icon": "assets/brand-icon.png",
      "category": "Office;Viewer;",
      "maintainer": "Grdh_Ravan <Nischal060@gmail.com>",
      "synopsis": "A fast, private, offline desktop PDF viewer",
      "description": "PDFForge Viewer is a fast, private, 100% offline desktop PDF viewer and document creator.",
      "mimeTypes": [
        "application/pdf"
      ],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "PDFForge Viewer document",
          "mimeType": "application/pdf",
          "role": "Viewer"
        }
      ]
    },
    "deb": {
      "artifactName": "PDFForge-Setup-${version}-${arch}.${ext}",
      "priority": "optional"
    },
    "appImage": {
      "artifactName": "PDFForge-${version}-${arch}.${ext}"
    },
    "snap": {
      "artifactName": "pdfforge-viewer_${version}_${arch}.${ext}",
      "confinement": "strict",
      "grade": "stable",
      "summary": "A fast, private, offline desktop PDF viewer",
      "plugs": [
        "default",
        "removable-media",
        "cups-control"
      ]
    }
  }
}
